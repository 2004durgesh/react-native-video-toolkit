#!/bin/sh

set -e

# Snapshot the files that were staged before the hook ran, so that at the end
# we only re-stage those (with formatting/lint fixes applied) instead of
# sweeping in unstaged or untracked changes.
STAGED_FILES=$(git diff --cached --name-only)

# Ensure README.md is restored if script exits
trap 'test -f README.mdx && mv README.mdx README.md' EXIT

yarn prepare 

# Run docs build only if ./docs changed
if ! git diff --quiet --cached -- ./docs; then
  echo "Docs changed → running build:docs..."
  yarn docs clean
  yarn docs build:docs
else
  echo "Docs not changed → skipping docs build."
fi

yarn typecheck

# rename README.md to README.mdx before formatting
mv README.md README.mdx

yarn prettier --write .

# rename back to README.md after formatting
mv README.mdx README.md

yarn lint --fix .

# Re-stage only the originally staged files, preserving any changes made above
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | while IFS= read -r file; do
    git add -A -- "$file"
  done
fi
