{
  "name": "react-native-video-toolkit-example",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tv": "EXPO_TV=1 expo start",
    "android:tv": "EXPO_TV=1 expo run:android",
    "android": "EXPO_TV=0 expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "prebuild": "EXPO_TV=0 expo prebuild",
    "prebuild:tv": "EXPO_TV=1 expo prebuild",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --scheme VideotoolkitExample --mode Debug --extra-params \"-sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO\"",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "latest",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86-stable",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-orientation-director": "^2.6.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-video": "7.0.0-beta.11",
    "react-native-video-toolkit": "workspace:*",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native-tvos/config-tv": "^0.1.3",
    "react-native-builder-bob": "^0.43.1"
  },
  "private": true
}
